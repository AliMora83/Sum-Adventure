# Copy to .env.local and fill in. .env.local is gitignored; never commit
# real keys.

# Sprint 4 — enquiry form
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Canonical site origin for metadataBase and OG image URLs.
#
# REQUIRED — the build fails if this is empty. There is no VERCEL_URL
# fallback: that value is unique per deployment, so OG URLs would change on
# every push and already-scraped previews would point at dead deployments.
#
# Set it per environment to that environment's stable origin:
#   local dev  http://localhost:3000
#   staging    https://<the .vercel.app alias>
#   production the client's domain
NEXT_PUBLIC_SITE_URL=
