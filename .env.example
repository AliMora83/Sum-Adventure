# Copy to .env.local and fill in. .env.local is gitignored; never commit
# real keys.

# Sprint 4 — enquiry form
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Canonical site origin for metadataBase and OG image URLs.
#
# REQUIRED — the build fails if this is empty. There is no fallback to the
# platform's own deploy URL (Netlify's DEPLOY_URL / DEPLOY_PRIME_URL): those
# are unique per deployment, so OG URLs would change on every push and
# already-scraped previews would point at dead deployments.
#
# It is also half of the indexability check — see CONTEXT below and
# lib/indexable.ts. A hostname ending in .netlify.app is never indexed.
#
# Set it per environment to that environment's stable origin:
#   local dev  http://localhost:3000
#   staging    the Netlify deploy URL for the staging branch
#   production the client's domain
NEXT_PUBLIC_SITE_URL=

# Netlify's build context. DO NOT SET THIS BY HAND — Netlify sets it on every
# build, and this entry documents it rather than configures it. Listed here
# because two behaviours key on it and neither is obvious from the code:
#
#   - the provisional-data build guards (lib/provisional.ts)
#   - whether the build is indexable (lib/indexable.ts)
#
# Netlify's values: production · deploy-preview · branch-deploy · dev
# Unset or "dev" is treated as a local build: guards off, never indexed.
#
# This replaced VERCEL_ENV in Sprint 9. VERCEL_ENV is unset on Netlify, so
# while the guards still read it they could not fire on any deploy.
CONTEXT=

# Escape hatch for the provisional-data guards. Leave empty.
#
# Set to exactly "1" to downgrade the guards from a build failure to a loud
# warning that names every offending field. Any other value leaves them armed
# — it fails closed on purpose, so a typo cannot silently disarm them.
#
# **This must not be set on the real domain.** Ten placeholder values are
# live right now (five organisation fields, five summit pass names); with
# this set they publish. It exists for a throwaway preview of unrelated work,
# nothing else. Deleting it from the Netlify environment before launch is a
# LAUNCH BLOCKING item in docs/launch-checklist.md.
ALLOW_PROVISIONAL_DEPLOY=
